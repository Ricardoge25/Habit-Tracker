FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir gunicorn

COPY . .

# 👇 Valores placeholder SOLO para que collectstatic pueda cargar settings.py.
# Django run los sobreescribe con los reales gracias a --env-file en tiempo de ejecución.
ENV SECRET_KEY=build-time-placeholder-not-used-in-runtime
ENV DEBUG=False
ENV POSTGRES_DB=placeholder
ENV POSTGRES_USER=placeholder
ENV POSTGRES_PASSWORD=placeholder
ENV POSTGRES_HOST=placeholder
ENV POSTGRES_PORT=5432
ENV ALLOWED_HOSTS=localhost

RUN python manage.py collectstatic --noinput

EXPOSE 8000

CMD ["gunicorn", "habit_tracker.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]